# Store and check out text files with LF line endings on every OS,
# so Windows (CRLF) and the Linux CI runner never disagree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files are never modified.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.parquet binary
